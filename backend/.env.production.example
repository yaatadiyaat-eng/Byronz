# Byronz production provider
# Default: self-hosted Ollama on the same server/VPS
BYRONZ_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434

# Alternative: hosted OpenAI-compatible provider such as Groq
# BYRONZ_LLM_PROVIDER=groq
# OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_API_KEY=isi_api_key_anda
# OPENAI_COMPATIBLE_DEFAULT_MODEL=openai/gpt-oss-20b
# OPENAI_COMPATIBLE_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant,qwen/qwen3-32b,llama-3.3-70b-versatile

# Alternative: official Llama API
# BYRONZ_LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_BASE_URL=https://api.llama.com/compat/v1/
# LLAMA_API_KEY=isi_llama_api_key_anda
# OPENAI_COMPATIBLE_DEFAULT_MODEL=isi_model_id_llama_api_anda
# OPENAI_COMPATIBLE_MODELS=isi_model_id_llama_api_anda|Llama

BYRONZ_DB_PATH=/var/data/chat.db
CORS_ALLOWED_ORIGINS=https://api.domain-anda.com,capacitor://localhost,http://localhost,http://127.0.0.1
TRUSTED_HOSTS=api.domain-anda.com,localhost,127.0.0.1
